<UserControl x:Class="Planora.App.Views.GanttView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Planora.App.Controls"
             xmlns:vm="clr-namespace:Planora.App.ViewModels">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="200" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="6*" MinWidth="200" />
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="TaskSheet" Grid.Column="0"
                  ItemsSource="{Binding Rows}"
                  Style="{StaticResource SheetStyle}"
                  SelectionChanged="OnSheetSelectionChanged"
                  PreviewKeyDown="OnSheetPreviewKeyDown"
                  BeginningEdit="OnSheetBeginningEdit"
                  MouseDoubleClick="OnSheetDoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource SheetRowStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSummary}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInactive}" Value="True">
                            <Setter Property="Foreground" Value="#999999" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                            <Setter Property="Background" Value="#FFF4B8" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Background" Value="#E8EEF6" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="" Binding="{Binding RowNumber}" IsReadOnly="True" Width="34" CellStyle="{StaticResource RowNumberCell}" />
                <DataGridTextColumn Header="ⓘ" Binding="{Binding Indicators}" IsReadOnly="True" Width="40" />
                <DataGridTemplateColumn Header="Mode" Width="44" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:TaskRowViewModel">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets"
                                       ToolTip="Auto scheduled">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE8B1;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsManual}" Value="True">
                                                <Setter Property="Text" Value="&#xE718;" />
                                                <Setter Property="Foreground" Value="#3A9AAE" />
                                                <Setter Property="ToolTip" Value="Manually scheduled" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                <Setter Property="Text" Value="" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                                                <Setter Property="Text" Value="" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="NameColumn" Header="Task Name" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:TaskRowViewModel">
                            <TextBlock Text="{Binding Name}" Margin="{Binding IndentWidth, Converter={StaticResource IndentConverter}}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate DataType="vm:TaskRowViewModel">
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Margin="{Binding IndentWidth, Converter={StaticResource IndentConverter}}"
                                     Style="{StaticResource CellEditor}" Loaded="OnEditorLoaded" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource ChromeBorder}" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:GanttChart x:Name="Gantt" RowHeight="24" HeaderHeight="44" />
            <ScrollBar x:Name="GanttScroll" Grid.Row="1" Orientation="Horizontal" ValueChanged="OnGanttScroll" />
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="Planora.App.Views.GanttView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Planora.App.Controls"
             xmlns:infra="clr-namespace:Planora.App.Infrastructure"
             xmlns:vm="clr-namespace:Planora.App.ViewModels">
    <Grid x:Name="Layout">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="200" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="6*" MinWidth="200" />
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="TaskSheet" Grid.Column="0"
                  ItemsSource="{Binding Rows}"
                  Style="{StaticResource SheetStyle}"
                  SelectionChanged="OnSheetSelectionChanged"
                  PreviewKeyDown="OnSheetPreviewKeyDown"
                  BeginningEdit="OnSheetBeginningEdit"
                  MouseDoubleClick="OnSheetDoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource SheetRowStyle}">
                    <Setter Property="FontWeight" Value="{Binding RowFontWeight}" />
                    <Setter Property="FontStyle" Value="{Binding RowFontStyle}" />
                    <Setter Property="Foreground" Value="{Binding RowForeground}" />
                    <Setter Property="FontSize" Value="{Binding RowFontSize}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                            <Setter Property="Background" Value="#FFF6D9" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Background" Value="#F4F5F8" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" IsReadOnly="True" Width="40" CellStyle="{StaticResource RowNumberCell}" />
                <DataGridTemplateColumn Header="Status" Width="58" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:TaskRowViewModel">
                            <controls:StatusGlyph Kind="{Binding StatusKind}" Percent="{Binding ProgressValue}" ToolTip="{Binding StatusToolTip}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="&#x24D8;" Binding="{Binding Indicators}" IsReadOnly="True" Width="34">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                            <Setter Property="FontSize" Value="12" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Mode" Width="54" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:TaskRowViewModel">
                            <Border Background="Transparent" ToolTip="Auto scheduled" x:Name="Host">
                                <infra:LineIcon x:Name="Icon" Kind="auto" Size="13" StrokeWidth="1.6" Foreground="{StaticResource TextFaint}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsManual}" Value="True">
                                    <Setter TargetName="Icon" Property="Kind" Value="pin" />
                                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource TextSecondary}" />
                                    <Setter TargetName="Host" Property="ToolTip" Value="Manually scheduled" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="NameColumn" Header="Task Name" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:TaskRowViewModel">
                            <DockPanel Margin="{Binding IndentWidth, Converter={StaticResource IndentConverter}}">
                                <Grid DockPanel.Dock="Left" Width="16" Margin="0,0,6,0">
                                    <Button x:Name="Toggle" Style="{StaticResource CmdButton}" Height="18" MinWidth="16" Width="16" Padding="0"
                                            Command="{Binding ToggleCollapseCommand}" CommandParameter="{Binding}" Visibility="Collapsed"
                                            ToolTip="Show or hide the subtasks">
                                        <infra:LineIcon x:Name="Chevron" Kind="chevD" Size="13" StrokeWidth="2" />
                                    </Button>
                                    <Rectangle x:Name="Diamond" Width="7" Height="7" Fill="{StaticResource Navy}" RadiusX="1" RadiusY="1"
                                               RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                                        <Rectangle.RenderTransform>
                                            <RotateTransform Angle="45" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSummary}" Value="True">
                                    <Setter TargetName="Toggle" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                    <Setter TargetName="Chevron" Property="Kind" Value="chevR" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMilestoneRow}" Value="True">
                                    <Setter TargetName="Diamond" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate DataType="vm:TaskRowViewModel">
                            <TextBox SpellCheck.IsEnabled="True" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Margin="{Binding IndentWidth, Converter={StaticResource IndentConverter}}"
                                     Style="{StaticResource CellEditor}" Loaded="OnEditorLoaded" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter x:Name="Splitter" Grid.Column="1" HorizontalAlignment="Stretch" Background="White" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1,0,0,0" />

        <Grid x:Name="ChartArea" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:GanttChart x:Name="Gantt" RowHeight="30" HeaderHeight="58" />
            <ScrollBar x:Name="GanttScroll" Grid.Row="1" Orientation="Horizontal" ValueChanged="OnGanttScroll" />
        </Grid>
    </Grid>
</UserControl>

<Window x:Class="Planora.App.Dialogs.ResourceInformationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resource Information" Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" IsDefault="True" Style="{StaticResource DialogButton}" Click="OnOk" />
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
        </StackPanel>

        <TabControl Width="600" Height="360">
            <TabItem Header="General">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Resource name:" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding ResourceName}" Style="{StaticResource FormText}" />
                    <TextBlock Grid.Column="3" Text="Initials:" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Column="4" Text="{Binding Initials}" Style="{StaticResource FormText}" />

                    <TextBlock Grid.Row="1" Text="Email:" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Email}" Style="{StaticResource FormText}" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Group:" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Group}" Style="{StaticResource FormText}" />

                    <TextBlock Grid.Row="2" Text="Type:" Style="{StaticResource FormLabel}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Types}" SelectedIndex="{Binding TypeIndex}" Style="{StaticResource FormCombo}" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Code:" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding Code}" Style="{StaticResource FormText}" />

                    <TextBlock Grid.Row="3" Text="Material label:" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MaterialLabel}" Style="{StaticResource FormText}" />
                    <TextBlock Grid.Row="3" Grid.Column="3" Text="Max. units:" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding MaxUnits}" Style="{StaticResource FormText}" />

                    <TextBlock Grid.Row="4" Text="Base calendar:" Style="{StaticResource FormLabel}" />
                    <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding CalendarNames}" SelectedIndex="{Binding CalendarIndex}" Style="{StaticResource FormCombo}" />
                    <TextBlock Grid.Row="4" Grid.Column="3" Text="Cost accrual:" Style="{StaticResource FormLabel}" />
                    <ComboBox Grid.Row="4" Grid.Column="4" ItemsSource="{Binding Accruals}" SelectedIndex="{Binding AccrualIndex}" Style="{StaticResource FormCombo}" />

                    <CheckBox Grid.Row="5" Grid.Column="1" Content="Budget resource" IsChecked="{Binding IsBudget}" Style="{StaticResource FormCheck}"
                              ToolTip="Budget resources hold project-level budget amounts and cannot be assigned to tasks." />
                    <Button Grid.Row="5" Grid.Column="3" Grid.ColumnSpan="2" Content="Change Working Time..." HorizontalAlignment="Left"
                            Padding="10,3" Margin="0,4" Click="OnChangeWorkingTime" />

                    <TextBlock Grid.Row="6" Text="Booking type:" Style="{StaticResource FormLabel}" />
                    <ComboBox Grid.Row="6" Grid.Column="1" SelectedIndex="{Binding BookingTypeIndex}" Style="{StaticResource FormCombo}"
                              ToolTip="Proposed bookings are tentative and are not leveled">
                        <ComboBoxItem Content="Committed" />
                        <ComboBoxItem Content="Proposed" />
                    </ComboBox>
                    <CheckBox Grid.Row="6" Grid.Column="3" Grid.ColumnSpan="2" Content="Generic" IsChecked="{Binding IsGeneric}" Style="{StaticResource FormCheck}"
                              ToolTip="Stands for a skill or role rather than a person" />
                    <CheckBox Grid.Row="7" Grid.Column="1" Content="Can level" IsChecked="{Binding CanLevel}" Style="{StaticResource FormCheck}"
                              ToolTip="Whether resource leveling may move this resource's assignments" />
                </Grid>
            </TabItem>

            <TabItem Header="Costs">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#555"
                               Text="Rates per hour for work resources (per unit for material). Add dated rows for rate changes; the first row applies from the start." />
                    <TabControl x:Name="RateTabs" />
                </DockPanel>
            </TabItem>

            <TabItem Header="Availability">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#555"
                               Text="Periods when the resource has different units available (e.g. 50% during March). Outside these periods, Max. units applies. Leave 'Available To' empty for open-ended." />
                    <DataGrid ItemsSource="{Binding AvailabilityRows}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                              HeadersVisibility="All" RowHeight="24">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Available From" Binding="{Binding From}" Width="140" />
                            <DataGridTextColumn Header="Available To" Binding="{Binding To}" Width="140" />
                            <DataGridTextColumn Header="Units" Binding="{Binding Units}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Notes">
                <TextBox Margin="8" Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

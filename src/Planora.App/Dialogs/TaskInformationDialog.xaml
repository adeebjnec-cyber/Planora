<Window x:Class="Planora.App.Dialogs.TaskInformationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Information" Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" IsDefault="True" Style="{StaticResource DialogButton}" Click="OnOk" />
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
        </StackPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Name:" Style="{StaticResource FormLabel}" />
            <TextBox Grid.Column="1" Text="{Binding TaskName}" Style="{StaticResource FormText}" MinWidth="300" />
            <TextBlock Grid.Column="2" Text="Duration:" Style="{StaticResource FormLabel}" Margin="14,4,10,4" />
            <TextBox Grid.Column="3" Text="{Binding Duration}" Style="{StaticResource FormText}" MinWidth="90"
                     IsEnabled="{Binding IsLeaf}" ToolTip="e.g. 3d, 2w, 4h, 5ed (elapsed), 2d? (estimated)" />
        </Grid>

        <TabControl Width="620" Height="330">
            <TabItem Header="General">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="% Complete:" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding PercentComplete}" Style="{StaticResource FormText}" />
                    <TextBlock Grid.Column="3" Text="Priority:" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Column="4" Text="{Binding Priority}" Style="{StaticResource FormText}" ToolTip="0-1000; 1000 = never delay when leveling" />

                    <TextBlock Grid.Row="1" Text="Schedule mode:" Style="{StaticResource FormLabel}" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding IsLeaf}">
                        <RadioButton Content="Auto" IsChecked="{Binding IsAuto}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <RadioButton Content="Manual" IsChecked="{Binding IsManual}" VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Content="Inactive" IsChecked="{Binding IsInactive}" Style="{StaticResource FormCheck}" />

                    <TextBlock Grid.Row="2" Text="Start:" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Start}" Style="{StaticResource FormText}" IsEnabled="{Binding IsLeaf}" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Finish:" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding Finish}" Style="{StaticResource FormText}" IsEnabled="{Binding IsLeaf}" />

                    <CheckBox Grid.Row="3" Grid.Column="1" Content="Estimated duration" IsChecked="{Binding IsEstimated}" Style="{StaticResource FormCheck}" IsEnabled="{Binding IsLeaf}" />
                    <CheckBox Grid.Row="3" Grid.Column="4" Content="Display as milestone" IsChecked="{Binding IsMilestone}" Style="{StaticResource FormCheck}" IsEnabled="{Binding IsLeaf}" />

                    <TextBlock Grid.Row="4" Grid.ColumnSpan="5" Margin="0,14,0,0" Foreground="#666" TextWrapping="Wrap"
                               Text="Typing a start or finish date on an auto-scheduled task sets a Start/Finish No Earlier Than constraint, as in Microsoft Project." />
                </Grid>
            </TabItem>

            <TabItem Header="Predecessors">
                <DataGrid Margin="8" ItemsSource="{Binding PredecessorEntries}" AutoGenerateColumns="False" CanUserAddRows="True"
                          CanUserDeleteRows="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource GridLine}" RowHeight="24">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID (row)" Binding="{Binding Row, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                        <DataGridTextColumn Header="Task Name" Binding="{Binding TaskName}" IsReadOnly="True" Width="*" />
                        <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding Type}" Width="70">
                            <DataGridComboBoxColumn.ItemsSource>
                                <x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                    <sys:String>FS</sys:String>
                                    <sys:String>SS</sys:String>
                                    <sys:String>FF</sys:String>
                                    <sys:String>SF</sys:String>
                                </x:Array>
                            </DataGridComboBoxColumn.ItemsSource>
                        </DataGridComboBoxColumn>
                        <DataGridTextColumn Header="Lag" Binding="{Binding Lag}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Resources" IsEnabled="{Binding IsLeaf}">
                <DataGrid Margin="8" ItemsSource="{Binding AssignmentEntries}" AutoGenerateColumns="False" CanUserAddRows="True"
                          CanUserDeleteRows="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource GridLine}" RowHeight="24">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Resource Name" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ResourceName}" VerticalAlignment="Center" Margin="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="True" Text="{Binding ResourceName, UpdateSourceTrigger=LostFocus}"
                                              ItemsSource="{Binding DataContext.ResourceNames, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Units" Binding="{Binding Units}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Advanced">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Deadline:" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding Deadline}" Style="{StaticResource FormText}" ToolTip="Leave empty for no deadline" />
                    <TextBlock Grid.Column="3" Text="WBS code:" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Column="4" Text="{Binding Wbs, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource FormText}" />

                    <TextBlock Grid.Row="1" Text="Constraint type:" Style="{StaticResource FormLabel}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ConstraintTypes}" SelectedIndex="{Binding ConstraintIndex}" Style="{StaticResource FormCombo}" IsEnabled="{Binding IsLeaf}" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Constraint date:" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding ConstraintDate}" Style="{StaticResource FormText}" IsEnabled="{Binding IsLeaf}" />

                    <TextBlock Grid.Row="2" Text="Task type:" Style="{StaticResource FormLabel}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding TaskTypes}" SelectedIndex="{Binding TaskTypeIndex}" Style="{StaticResource FormCombo}" IsEnabled="{Binding IsLeaf}" />
                    <CheckBox Grid.Row="2" Grid.Column="4" Content="Effort driven" IsChecked="{Binding IsEffortDriven}" Style="{StaticResource FormCheck}" IsEnabled="{Binding IsLeaf}" />

                    <TextBlock Grid.Row="3" Text="Calendar:" Style="{StaticResource FormLabel}" />
                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding CalendarChoices}" SelectedIndex="{Binding CalendarIndex}" Style="{StaticResource FormCombo}" />
                    <CheckBox Grid.Row="3" Grid.Column="4" Content="Scheduling ignores resource calendars" IsChecked="{Binding IgnoreResourceCalendar}" Style="{StaticResource FormCheck}" />

                    <TextBlock Grid.Row="4" Text="Fixed cost:" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding FixedCost}" Style="{StaticResource FormText}" />
                    <TextBlock Grid.Row="4" Grid.Column="3" Text="Fixed cost accrual:" Style="{StaticResource FormLabel}" />
                    <ComboBox Grid.Row="4" Grid.Column="4" ItemsSource="{Binding Accruals}" SelectedIndex="{Binding FixedCostAccrualIndex}" Style="{StaticResource FormCombo}" />

                    <TextBlock Grid.Row="5" Text="Hyperlink text:" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Hyperlink}" Style="{StaticResource FormText}" />
                    <TextBlock Grid.Row="5" Grid.Column="3" Text="Address:" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Row="5" Grid.Column="4" Text="{Binding HyperlinkAddress}" Style="{StaticResource FormText}" ToolTip="A web address or a file path" />

                    <TextBlock Grid.Row="6" Text="Sub-address:" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding HyperlinkSubAddress}" Style="{StaticResource FormText}" />

                    <CheckBox Grid.Row="7" Grid.Column="1" Content="Marked" IsChecked="{Binding IsMarked}" Style="{StaticResource FormCheck}" />
                    <CheckBox Grid.Row="7" Grid.Column="4" Content="Hide task bar" IsChecked="{Binding HideBar}" Style="{StaticResource FormCheck}" />
                </Grid>
            </TabItem>

            <TabItem Header="Notes">
                <TextBox Margin="8" Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

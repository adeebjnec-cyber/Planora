<Window x:Class="Planora.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Planora.App.ViewModels"
        xmlns:views="clr-namespace:Planora.App.Views"
        xmlns:infra="clr-namespace:Planora.App.Infrastructure"
        Title="{Binding WindowTitle}"
        Height="900" Width="1440" MinHeight="560" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/Planora.ico"
        Background="{StaticResource AppBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFontFamily}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <CollectionViewSource x:Key="ViewsSource" Source="{Binding Views}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Section" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <infra:EqualsConverter x:Key="Equals" />

        <!-- Sub-menu items generated from a list of names, checked when the name is the current one. -->
        <Style x:Key="TableItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding}" />
            <Setter Property="Command" Value="{Binding DataContext.SetTableCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
            <Setter Property="IsChecked">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource Equals}" Mode="OneWay">
                        <Binding />
                        <Binding Path="DataContext.CurrentTableName" RelativeSource="{RelativeSource AncestorType=Window}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding}" />
            <Setter Property="Command" Value="{Binding DataContext.SetFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
            <Setter Property="IsChecked">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource Equals}" Mode="OneWay">
                        <Binding />
                        <Binding Path="DataContext.CurrentFilterName" RelativeSource="{RelativeSource AncestorType=Window}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GroupNameItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding}" />
            <Setter Property="Command" Value="{Binding DataContext.SetGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
            <Setter Property="IsChecked">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource Equals}" Mode="OneWay">
                        <Binding />
                        <Binding Path="DataContext.CurrentGroupName" RelativeSource="{RelativeSource AncestorType=Window}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SavedViewItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding}" />
            <Setter Property="Command" Value="{Binding DataContext.ApplySavedViewCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
        </Style>

        <Style x:Key="BarLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,18,0" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F12" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}" />
        <KeyBinding Key="Insert" Command="{Binding InsertTaskCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt+Shift" Command="{Binding IndentCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt+Shift" Command="{Binding OutdentCommand}" />
        <KeyBinding Key="Up" Modifiers="Alt+Shift" Command="{Binding MoveTaskUpCommand}" />
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding FindCommand}" />
        <KeyBinding Key="H" Modifiers="Ctrl" Command="{Binding ReplaceCommand}" />
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding FillDownCommand}" />
        <KeyBinding Key="F7" Command="{Binding SpellingCommand}" />
        <KeyBinding Key="F9" Command="{Binding CalculateCommand}" />
        <KeyBinding Key="F8" Modifiers="Alt" Command="{Binding MacrosCommand}" />
        <KeyBinding Key="Down" Modifiers="Alt+Shift" Command="{Binding MoveTaskDownCommand}" />
        <KeyBinding Key="F2" Modifiers="Control" Command="{Binding LinkCommand}" />
        <KeyBinding Key="F2" Modifiers="Control+Shift" Command="{Binding UnlinkCommand}" />
        <KeyBinding Key="F5" Modifiers="Control+Shift" Command="{Binding ScrollToTaskCommand}" />
        <KeyBinding Key="F2" Modifiers="Shift" Command="{Binding TaskInformationCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ sidebar -->
        <Border Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="48" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="26" Height="26">
                            <Border Background="{StaticResource Navy}" CornerRadius="6.5" />
                            <Border Background="White" CornerRadius="1.5" Width="9.5" Height="3.2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,6.8,0,0" />
                            <Border Background="#8F9AEA" CornerRadius="1.5" Width="12.5" Height="3.2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8.7,11.4,0,0" />
                            <Border Background="#BFFFFFFF" CornerRadius="1.5" Width="8" Height="3.2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="13,16,0,0" />
                        </Grid>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="P L A N O R A" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="Project Management" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Project card, save state, credit -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="14,12,14,10">
                    <StackPanel>
                        <DockPanel>
                            <Border Width="30" Height="30" CornerRadius="7" Background="#ECEEF2" DockPanel.Dock="Left">
                                <infra:LineIcon Kind="building" Size="16" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProjectTitle}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectTitle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Ellipse x:Name="ProjectDot" Width="6" Height="6" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">
                                        <Run Text="Project status: " /><Run Text="{Binding ProjectStatusText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <Border Margin="0,10,0,0" Padding="9,6" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="7" Background="White">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding LastSavedText}" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="SideSaveDot" Width="6" Height="6" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding SaveStateText}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock Text="Developed by Adeeb" FontSize="10.5" Foreground="{StaticResource TextFaint}" Margin="2,10,0,0" />
                    </StackPanel>
                </Border>

                <ListBox x:Name="Nav" ItemsSource="{Binding Source={StaticResource ViewsSource}}" SelectedItem="{Binding CurrentViewOption}"
                         Background="Transparent" BorderThickness="0" Padding="10,6,10,6" FocusVisualStyle="{x:Null}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextMuted}" Margin="8,12,0,6" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Margin="0,1">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Height="30" Padding="10,0">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                            <Border x:Name="Mark" Width="2" Height="14" CornerRadius="0,2,2,0" Background="{DynamicResource Accent}"
                                                    HorizontalAlignment="Left" Margin="-10,0,0,0" Opacity="0" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFill}" />
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                                <Setter Property="FontWeight" Value="Medium" />
                                                <Setter TargetName="Mark" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ViewOption}">
                            <StackPanel Orientation="Horizontal">
                                <infra:LineIcon x:Name="Icon" Kind="{Binding Icon}" Size="17" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Accent}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============================================================ main area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- Top bar: breadcrumb, search, notifications, settings, account -->
            <Border Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="16,0,14,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SearchBox" Click="OnOpenPalette" Width="280" Height="30" Padding="10,0,6,0" Cursor="IBeam" Focusable="False"
                                Background="#FAFAFB" HorizontalContentAlignment="Stretch" ToolTip="Search for any command or task (Ctrl+K)">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1" CornerRadius="4" Padding="5,1" Background="White">
                                    <TextBlock Text="Ctrl K" FontSize="10.5" Foreground="{StaticResource TextMuted}" />
                                </Border>
                                <infra:LineIcon Kind="find" Size="15" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                <TextBlock Text="Search commands" Foreground="{StaticResource TextMuted}" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>
                        <Grid Margin="8,0,0,0">
                            <ToggleButton x:Name="BellButton" Style="{StaticResource CmdButton}" Width="30" Height="30" ToolTip="Schedule warnings">
                                <infra:LineIcon Kind="bell" Size="17" />
                            </ToggleButton>
                            <Border x:Name="BellBadge" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
                                    MinWidth="14" Height="14" CornerRadius="7" Background="{StaticResource Warning}" BorderBrush="White" BorderThickness="1.5" Padding="2,0">
                                <TextBlock Text="{Binding WarningCount}" FontSize="8.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Popup IsOpen="{Binding IsChecked, ElementName=BellButton}" StaysOpen="False" PlacementTarget="{Binding ElementName=BellButton}"
                                   Placement="Bottom" HorizontalOffset="-300" AllowsTransparency="True" PopupAnimation="Fade">
                                <ContentControl Template="{StaticResource MenuPopupPanel}">
                                    <StackPanel Width="330">
                                        <TextBlock Text="Schedule warnings" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextMuted}" Margin="10,7,10,5" />
                                        <ItemsControl ItemsSource="{Binding Warnings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ScheduleWarning}">
                                                    <DockPanel Margin="10,6,10,6">
                                                        <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource Warning}" VerticalAlignment="Top" Margin="0,5,10,0" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="12.5" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="red">
                                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Critical}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="gray">
                                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource TextFaint}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="NoWarnings" Text="No warnings. The schedule looks healthy." FontSize="12" Foreground="{StaticResource TextMuted}"
                                                   Margin="10,8,10,10" Visibility="Collapsed" />
                                    </StackPanel>
                                </ContentControl>
                            </Popup>
                        </Grid>
                        <Button Style="{StaticResource CmdButton}" Width="30" Height="30" Margin="2,0,0,0" Command="{Binding OptionsCommand}" ToolTip="Options">
                            <infra:LineIcon Kind="settings" Size="17" />
                        </Button>
                        <Button x:Name="AccountButton" Click="OnAccountMenu" Focusable="False" Margin="6,0,0,0" Padding="0" BorderThickness="0" Background="Transparent"
                                ToolTip="Planora · Developed by Adeeb">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource Navy}">
                                        <TextBlock Text="A" Foreground="White" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProjectParent}" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                        <TextBlock Text="/" Foreground="{StaticResource TextFaint}" Margin="8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ProjectTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                        <Border Margin="10,0,0,0" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1" CornerRadius="5" Padding="6,1" VerticalAlignment="Center"
                                Visibility="{Binding HasBaseline, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Baseline" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                        </Border>
                        <Border Margin="6,0,0,0" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1" CornerRadius="5" Padding="6,1" VerticalAlignment="Center"
                                Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Edited" FontSize="11" Foreground="{StaticResource Warning}" />
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Command bar: menus with every command, then the most used commands -->
            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="0,0,0,1" Padding="10,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="{Binding ShowCriticalPath}" Content="Critical path"
                                      ToolTip="Show the critical path in red" />
                        <Border BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1" CornerRadius="7" Height="28" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource CmdButton}" Height="26" MinWidth="26" Command="{Binding ZoomOutCommand}" ToolTip="Zoom out (Ctrl+-)">
                                    <infra:LineIcon Kind="minus" Size="15" />
                                </Button>
                                <TextBlock Text="{Binding ZoomLabel}" Width="62" TextAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource CmdButton}" Height="26" MinWidth="26" Command="{Binding ZoomInCommand}" ToolTip="Zoom in (Ctrl++)">
                                    <infra:LineIcon Kind="plus" Size="15" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="CommandStrip" Orientation="Horizontal" VerticalAlignment="Center">
                        <Menu x:Name="MainMenu" VerticalAlignment="Center">
                            <MenuItem Header="File" Click="OnFileMenu" />
                            <MenuItem Header="Task">
                                <MenuItem Header="Paste" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V" />
                                <MenuItem Header="Cut" Command="{Binding CutCommand}" InputGestureText="Ctrl+X" />
                                <MenuItem Header="Copy" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C" />
                                <Separator />
                                <MenuItem Header="Insert">
                                    <MenuItem Header="Task" Command="{Binding InsertTaskCommand}" InputGestureText="Insert" />
                                    <MenuItem Header="Summary Task" Command="{Binding InsertSummaryCommand}" />
                                    <MenuItem Header="Milestone" Command="{Binding InsertMilestoneCommand}" />
                                    <MenuItem Header="Recurring Task..." Command="{Binding RecurringTaskCommand}" />
                                </MenuItem>
                                <MenuItem Header="Indent" Command="{Binding IndentCommand}" InputGestureText="Alt+Shift+Right" />
                                <MenuItem Header="Outdent" Command="{Binding OutdentCommand}" InputGestureText="Alt+Shift+Left" />
                                <MenuItem Header="Move Up" Command="{Binding MoveTaskUpCommand}" InputGestureText="Alt+Shift+Up" />
                                <MenuItem Header="Move Down" Command="{Binding MoveTaskDownCommand}" InputGestureText="Alt+Shift+Down" />
                                <Separator />
                                <MenuItem Header="Link Tasks" Command="{Binding LinkCommand}" InputGestureText="Ctrl+F2" />
                                <MenuItem Header="Unlink Tasks" Command="{Binding UnlinkCommand}" InputGestureText="Ctrl+Shift+F2" />
                                <MenuItem Header="Split Task..." Command="{Binding SplitTaskCommand}" />
                                <MenuItem Header="Split Mode" IsCheckable="True" IsChecked="{Binding IsSplitMode}" />
                                <Separator />
                                <MenuItem Header="Progress">
                                    <MenuItem Header="0% Complete" Command="{Binding PercentCompleteCommand}" CommandParameter="0" />
                                    <MenuItem Header="25% Complete" Command="{Binding PercentCompleteCommand}" CommandParameter="25" />
                                    <MenuItem Header="50% Complete" Command="{Binding PercentCompleteCommand}" CommandParameter="50" />
                                    <MenuItem Header="75% Complete" Command="{Binding PercentCompleteCommand}" CommandParameter="75" />
                                    <MenuItem Header="100% Complete" Command="{Binding PercentCompleteCommand}" CommandParameter="100" />
                                    <Separator />
                                    <MenuItem Header="Mark on Track" Command="{Binding MarkOnTrackCommand}" />
                                    <MenuItem Header="Update Tasks..." Command="{Binding UpdateTasksCommand}" />
                                </MenuItem>
                                <MenuItem Header="Manually Schedule / Auto Schedule" Command="{Binding ToggleModeCommand}" />
                                <MenuItem Header="Inspect" IsCheckable="True" IsChecked="{Binding ShowInspector}" />
                                <MenuItem Header="Go To Selected Task" Command="{Binding ScrollToTaskCommand}" InputGestureText="Ctrl+Shift+F5" />
                                <MenuItem Header="Add to Timeline" Command="{Binding AddToTimelineCommand}" />
                                <Separator />
                                <MenuItem Header="Find..." Command="{Binding FindCommand}" InputGestureText="Ctrl+F" />
                                <MenuItem Header="Replace..." Command="{Binding ReplaceCommand}" InputGestureText="Ctrl+H" />
                                <MenuItem Header="Fill Down" Command="{Binding FillDownCommand}" InputGestureText="Ctrl+D" />
                                <MenuItem Header="Spelling..." Command="{Binding SpellingCommand}" InputGestureText="F7" />
                                <Separator />
                                <MenuItem Header="Task Information..." Command="{Binding TaskInformationCommand}" InputGestureText="Shift+F2" />
                                <MenuItem Header="Open Hyperlink" Command="{Binding OpenHyperlinkCommand}" />
                                <MenuItem Header="Delete Task" Command="{Binding DeleteTaskCommand}" InputGestureText="Del" />
                            </MenuItem>
                            <MenuItem Header="Resource">
                                <MenuItem Header="Resource Sheet" Click="OnShowResourceSheet" />
                                <MenuItem Header="Resource Usage" Click="OnShowResourceUsage" />
                                <MenuItem Header="Team Planner" Click="OnShowTeamPlanner" />
                                <Separator />
                                <MenuItem Header="Resource Information..." Command="{Binding ResourceInformationCommand}" />
                                <MenuItem Header="Delete Resource" Command="{Binding DeleteResourceCommand}" />
                                <MenuItem Header="Budgets..." Command="{Binding BudgetsCommand}" />
                                <Separator />
                                <MenuItem Header="Share Resources..." Command="{Binding ShareResourcesCommand}" />
                                <MenuItem Header="Refresh from Pool" Command="{Binding RefreshPoolCommand}" />
                                <MenuItem Header="Update Pool" Command="{Binding UpdatePoolCommand}" />
                                <MenuItem Header="Pool Overallocations..." Command="{Binding PoolOverallocationsCommand}" />
                                <Separator />
                                <MenuItem Header="Level Resources..." Command="{Binding LevelResourcesCommand}" />
                            </MenuItem>
                            <MenuItem Header="Report">
                                <MenuItem Header="Dashboards">
                                    <MenuItem Header="Project Overview" Command="{Binding ReportsCommand}" CommandParameter="Project Overview" />
                                    <MenuItem Header="Cost Overview" Command="{Binding ReportsCommand}" CommandParameter="Cost Overview" />
                                    <MenuItem Header="Earned Value" Command="{Binding ReportsCommand}" CommandParameter="Earned Value" />
                                    <MenuItem Header="Burndown" Command="{Binding ReportsCommand}" CommandParameter="Burndown" />
                                    <MenuItem Header="Cash Flow" Command="{Binding ReportsCommand}" CommandParameter="Cash Flow" />
                                    <MenuItem Header="Work Overview" Command="{Binding ReportsCommand}" CommandParameter="Work Overview" />
                                    <MenuItem Header="Cost Overruns" Command="{Binding ReportsCommand}" CommandParameter="Cost Overruns" />
                                </MenuItem>
                                <MenuItem Header="Tasks">
                                    <MenuItem Header="Critical Tasks" Command="{Binding ReportsCommand}" CommandParameter="Critical Tasks" />
                                    <MenuItem Header="Task Status" Command="{Binding ReportsCommand}" CommandParameter="Task Status" />
                                    <MenuItem Header="Milestones" Command="{Binding ReportsCommand}" CommandParameter="Milestones" />
                                    <MenuItem Header="Late Tasks" Command="{Binding ReportsCommand}" CommandParameter="Late Tasks" />
                                    <MenuItem Header="Upcoming Tasks" Command="{Binding ReportsCommand}" CommandParameter="Upcoming Tasks" />
                                    <MenuItem Header="Slipping Tasks" Command="{Binding ReportsCommand}" CommandParameter="Slipping Tasks" />
                                </MenuItem>
                                <MenuItem Header="Resources">
                                    <MenuItem Header="Resource Overview" Command="{Binding ReportsCommand}" CommandParameter="Resource Overview" />
                                    <MenuItem Header="Who Does What" Command="{Binding ReportsCommand}" CommandParameter="Who Does What" />
                                    <MenuItem Header="Overallocated Resources" Command="{Binding ReportsCommand}" CommandParameter="Overallocated Resources" />
                                </MenuItem>
                                <MenuItem Header="Custom Reports..." Command="{Binding ReportsCommand}" />
                                <MenuItem Header="Compare Projects..." Command="{Binding CompareProjectsCommand}" />
                                <Separator />
                                <MenuItem Header="Export as PDF..." Command="{Binding ExportPdfCommand}" />
                                <MenuItem Header="Export as Image..." Command="{Binding ExportImageCommand}" />
                                <MenuItem Header="Print..." Command="{Binding PrintCommand}" InputGestureText="Ctrl+P" />
                                <MenuItem Header="Page Setup..." Command="{Binding PageSetupCommand}" />
                            </MenuItem>
                            <MenuItem Header="Project">
                                <MenuItem Header="Project Information..." Command="{Binding ProjectInformationCommand}" />
                                <MenuItem Header="Custom Fields..." Command="{Binding CustomFieldsCommand}" />
                                <MenuItem Header="Change Working Time..." Command="{Binding ChangeWorkingTimeCommand}" />
                                <MenuItem Header="Calculate Project" Command="{Binding CalculateCommand}" InputGestureText="F9" />
                                <Separator />
                                <MenuItem Header="Set Baseline..." Command="{Binding SetBaselineCommand}" />
                                <MenuItem Header="Clear Baseline..." Command="{Binding ClearBaselineCommand}" />
                                <MenuItem Header="Update Project..." Command="{Binding UpdateProjectCommand}" />
                                <Separator />
                                <MenuItem Header="Link to Other Project..." Command="{Binding LinkExternalCommand}" />
                                <MenuItem Header="Refresh External Links" Command="{Binding RefreshExternalLinksCommand}" />
                                <MenuItem Header="Insert Subproject..." Command="{Binding InsertProjectCommand}" />
                                <MenuItem Header="Refresh Subproject" Command="{Binding RefreshSubprojectCommand}" />
                                <MenuItem Header="Save Subproject" Command="{Binding SaveSubprojectCommand}" />
                                <Separator />
                                <MenuItem Header="Import..." Command="{Binding ImportCommand}" />
                                <MenuItem Header="Export..." Command="{Binding ExportCommand}" />
                            </MenuItem>
                            <MenuItem Header="View">
                                <MenuItem Header="Table" ItemsSource="{Binding TableNames}" ItemContainerStyle="{StaticResource TableItem}" />
                                <MenuItem Header="Filter" ItemsSource="{Binding FilterNames}" ItemContainerStyle="{StaticResource FilterItem}" />
                                <MenuItem Header="Group" ItemsSource="{Binding GroupNames}" ItemContainerStyle="{StaticResource GroupNameItem}" />
                                <MenuItem Header="Highlight Filter Matches" IsCheckable="True" IsChecked="{Binding HighlightFilter}" />
                                <MenuItem Header="Sort..." Command="{Binding SortCommand}" />
                                <MenuItem Header="Define">
                                    <MenuItem Header="Tables..." Command="{Binding EditTableCommand}" />
                                    <MenuItem Header="Filters..." Command="{Binding EditFilterCommand}" />
                                    <MenuItem Header="Groups..." Command="{Binding EditGroupCommand}" />
                                    <MenuItem Header="Custom Fields..." Command="{Binding CustomFieldsCommand}" />
                                    <MenuItem Header="Sort by ID" Command="{Binding SortByIdCommand}" />
                                    <MenuItem Header="Organizer..." Command="{Binding OrganizerCommand}" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Expand All" Command="{Binding ExpandAllCommand}" />
                                <MenuItem Header="Collapse All" Command="{Binding CollapseAllCommand}" />
                                <MenuItem Header="Zoom In" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++" />
                                <MenuItem Header="Zoom Out" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-" />
                                <Separator />
                                <MenuItem Header="Critical Path" IsCheckable="True" IsChecked="{Binding ShowCriticalPath}" />
                                <MenuItem Header="Baseline" IsCheckable="True" IsChecked="{Binding ShowBaseline}" />
                                <MenuItem x:Name="BaselineMenu" Header="Baseline to Show" />
                                <MenuItem Header="Progress Lines" IsCheckable="True" IsChecked="{Binding ShowProgressLines}" />
                                <MenuItem Header="Usage Details">
                                    <MenuItem Header="Actual Work" IsCheckable="True" IsChecked="{Binding ShowActualWorkDetail}" />
                                    <MenuItem Header="Remaining Work" IsCheckable="True" IsChecked="{Binding ShowRemainingWorkDetail}" />
                                    <MenuItem Header="Baseline Work" IsCheckable="True" IsChecked="{Binding ShowBaselineWorkDetail}" />
                                    <MenuItem Header="Cost" IsCheckable="True" IsChecked="{Binding ShowCostDetail}" />
                                    <MenuItem Header="Actual Cost" IsCheckable="True" IsChecked="{Binding ShowActualCostDetail}" />
                                    <MenuItem Header="Baseline Cost" IsCheckable="True" IsChecked="{Binding ShowBaselineCostDetail}" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Timeline Pane" IsCheckable="True" IsChecked="{Binding ShowTimelinePane}" />
                                <MenuItem Header="Details Pane" IsCheckable="True" IsChecked="{Binding ShowTaskForm}" />
                                <Separator />
                                <MenuItem Header="Save View..." Command="{Binding SaveViewCommand}" />
                                <MenuItem Header="Saved Views" ItemsSource="{Binding SavedViewNames}" ItemContainerStyle="{StaticResource SavedViewItem}" />
                                <MenuItem Header="Macros..." Command="{Binding MacrosCommand}" InputGestureText="Alt+F8" />
                            </MenuItem>
                            <MenuItem Header="Format">
                                <MenuItem Header="Text Styles..." Command="{Binding TextStylesCommand}" />
                                <MenuItem Header="Bar Styles..." Command="{Binding BarStylesCommand}" />
                                <MenuItem Header="Gridlines..." Command="{Binding GridlinesCommand}" />
                                <MenuItem Header="Timescale..." Command="{Binding TimescaleCommand}" />
                                <Separator />
                                <MenuItem Header="Task Path">
                                    <MenuItem Header="Predecessors" IsCheckable="True" IsChecked="{Binding ShowPathPredecessors}" />
                                    <MenuItem Header="Driving Predecessors" IsCheckable="True" IsChecked="{Binding ShowPathDrivingPredecessors}" />
                                    <MenuItem Header="Successors" IsCheckable="True" IsChecked="{Binding ShowPathSuccessors}" />
                                    <MenuItem Header="Driven Successors" IsCheckable="True" IsChecked="{Binding ShowPathDrivenSuccessors}" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Columns..." Command="{Binding EditTableCommand}" />
                                <MenuItem Header="Custom Fields..." Command="{Binding CustomFieldsCommand}" />
                            </MenuItem>
                            <MenuItem Header="Help">
                                <MenuItem Header="Search Commands" Click="OnOpenPalette" InputGestureText="Ctrl+K" />
                                <MenuItem Header="Open Sample Project" Command="{Binding OpenSampleCommand}" />
                                <Separator />
                                <MenuItem Header="About Planora" Click="OnAbout" />
                            </MenuItem>
                        </Menu>

                        <Rectangle Style="{StaticResource CmdSeparator}" />
                        <Button Style="{StaticResource CmdButton}" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)">
                            <infra:LineIcon Kind="undo" />
                        </Button>
                        <Button Style="{StaticResource CmdButton}" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)">
                            <infra:LineIcon Kind="redo" />
                        </Button>
                        <Rectangle Style="{StaticResource CmdSeparator}" />
                        <Button Style="{StaticResource CmdButton}" Command="{Binding CalculateCommand}" ToolTip="Recalculate the schedule (F9)">
                            <StackPanel Orientation="Horizontal">
                                <infra:LineIcon Kind="schedule" />
                                <TextBlock Text="Schedule" Style="{StaticResource BarLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource CmdButton}" Command="{Binding UpdateTasksCommand}" ToolTip="Update progress on the selected tasks">
                            <StackPanel Orientation="Horizontal">
                                <infra:LineIcon Kind="update" />
                                <TextBlock x:Name="UpdateLabel" Text="Update Tasks" Style="{StaticResource BarLabel}" />
                            </StackPanel>
                        </Button>
                        <ToggleButton Style="{StaticResource CmdButton}" IsChecked="{Binding ShowInspector}" ToolTip="Inspect: what drives the selected task's dates">
                            <infra:LineIcon Kind="inspect" />
                        </ToggleButton>
                        <Rectangle Style="{StaticResource CmdSeparator}" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding InsertTaskCommand}" ToolTip="Insert a task above the selection (Insert)">
                            <StackPanel Orientation="Horizontal">
                                <infra:LineIcon Kind="plus" />
                                <TextBlock Text="Add Task" Style="{StaticResource BarLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource CmdButton}" Margin="4,0,0,0" Command="{Binding InsertMilestoneCommand}" ToolTip="Insert a milestone">
                            <StackPanel Orientation="Horizontal">
                                <infra:LineIcon Kind="milestone" />
                                <TextBlock x:Name="MilestoneLabel" Text="Milestone" Style="{StaticResource BarLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource CmdButton}" Command="{Binding RecurringTaskCommand}" ToolTip="Insert a recurring task">
                            <infra:LineIcon Kind="recurring" />
                        </Button>
                        <Rectangle Style="{StaticResource CmdSeparator}" />
                        <Button Style="{StaticResource CmdButton}" Command="{Binding ScrollToTaskCommand}" ToolTip="Go to the selected task (Ctrl+Shift+F5)">
                            <infra:LineIcon Kind="goto" />
                        </Button>
                        <Button Style="{StaticResource CmdButton}" Command="{Binding FindCommand}" ToolTip="Find (Ctrl+F)">
                            <infra:LineIcon Kind="find" />
                        </Button>
                        <Button x:Name="FilterButton" Style="{StaticResource CmdButton}" Click="OnFilterMenu" ToolTip="Filter the tasks">
                            <StackPanel Orientation="Horizontal">
                                <infra:LineIcon Kind="filter" />
                                <TextBlock x:Name="FilterLabel" Text="{Binding CurrentFilterName}" Style="{StaticResource BarLabel}" MaxWidth="140" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource CmdButton}" Command="{Binding TaskInformationCommand}" ToolTip="Task properties (Shift+F2)">
                            <infra:LineIcon Kind="props" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Views -->
            <DockPanel Grid.Row="2" Background="White">
                <views:InspectorPanel DockPanel.Dock="Right" Width="300" Visibility="{Binding ShowInspector, Converter={StaticResource BoolToVisibility}}" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="TimelinePane" Height="185" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="0,0,0,1"
                            Visibility="{Binding ShowTimelinePane, Converter={StaticResource BoolToVisibility}}" />
                    <ContentControl x:Name="ViewHost" Grid.Row="1" Focusable="False" />
                    <views:TaskFormPanel Grid.Row="2" Height="230" Visibility="{Binding ShowTaskDetailsForm, Converter={StaticResource BoolToVisibility}}" />
                    <views:ResourceFormPanel Grid.Row="2" Height="230" Visibility="{Binding ShowResourceForm, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DockPanel>

            <!-- Status bar -->
            <Border Grid.Row="3" Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="0,1,0,0" Padding="14,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="SaveDot" Width="6" Height="6" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SaveStateText}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,18,0" />
                        <TextBlock FontSize="11.5" VerticalAlignment="Center">
                            <Run Text="Last saved: " Foreground="{StaticResource TextMuted}" /><Run Text="{Binding LastSavedText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource StatusLabel}">
                            <Run Text="Tasks " /><Run Text="{Binding TaskCount, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" FontWeight="Medium" />
                        </TextBlock>
                        <Ellipse Width="6" Height="6" Fill="{StaticResource Critical}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Style="{StaticResource StatusLabel}">
                            <Run Text="Critical " /><Run Text="{Binding CriticalCount, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" FontWeight="Medium" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource StatusLabel}">
                            <Run Text="Project duration " /><Run Text="{Binding ProjectDurationText, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" FontWeight="Medium" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource StatusLabel}">
                            <Run Text="Finish " /><Run Text="{Binding FinishText, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" FontWeight="Medium" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource StatusLabel}">
                            <Run Text="Resources " /><Run Text="{Binding ResourceCount, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" FontWeight="Medium" />
                        </TextBlock>
                        <TextBlock x:Name="StatusMessage" Text="{Binding Status}" Style="{StaticResource StatusLabel}" TextTrimming="CharacterEllipsis" MaxWidth="420"
                                   Foreground="{StaticResource TextFaint}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

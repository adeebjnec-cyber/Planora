<Window x:Class="Planora.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Planora.App.ViewModels"
        Title="{Binding WindowTitle}"
        Height="760" Width="1280" MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI" FontSize="12">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F12" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Insert" Command="{Binding InsertTaskCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt+Shift" Command="{Binding IndentCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt+Shift" Command="{Binding OutdentCommand}" />
        <KeyBinding Key="F2" Modifiers="Control" Command="{Binding LinkCommand}" />
        <KeyBinding Key="F2" Modifiers="Control+Shift" Command="{Binding UnlinkCommand}" />
        <KeyBinding Key="F5" Modifiers="Control+Shift" Command="{Binding ScrollToTaskCommand}" />
        <KeyBinding Key="F2" Modifiers="Shift" Command="{Binding TaskInformationCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{StaticResource ChromeBackground}" Padding="2">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Command="{Binding NewCommand}" />
                <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Command="{Binding OpenCommand}" />
                <MenuItem Header="Open Sa_mple Project" Command="{Binding OpenSampleCommand}" />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" />
                <MenuItem Header="Save _As..." InputGestureText="F12" Command="{Binding SaveAsCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
            </MenuItem>
            <MenuItem Header="_Task">
                <MenuItem Header="_Insert Task" InputGestureText="Ins" Command="{Binding InsertTaskCommand}" />
                <MenuItem Header="Insert _Milestone" Command="{Binding InsertMilestoneCommand}" />
                <MenuItem Header="Insert _Summary Task" Command="{Binding InsertSummaryCommand}" />
                <MenuItem Header="_Delete Task" InputGestureText="Del" Command="{Binding DeleteTaskCommand}" />
                <Separator />
                <MenuItem Header="I_ndent" InputGestureText="Alt+Shift+Right" Command="{Binding IndentCommand}" />
                <MenuItem Header="_Outdent" InputGestureText="Alt+Shift+Left" Command="{Binding OutdentCommand}" />
                <MenuItem Header="_Link Tasks" InputGestureText="Ctrl+F2" Command="{Binding LinkCommand}" />
                <MenuItem Header="_Unlink Tasks" InputGestureText="Ctrl+Shift+F2" Command="{Binding UnlinkCommand}" />
                <Separator />
                <MenuItem Header="Toggle _Manual / Auto Schedule" Command="{Binding ToggleModeCommand}" />
                <Separator />
                <MenuItem Header="Task _Information..." InputGestureText="Shift+F2" Command="{Binding TaskInformationCommand}" />
                <MenuItem Header="Add to _Timeline" Command="{Binding AddToTimelineCommand}" />
            </MenuItem>
            <MenuItem Header="_Resource">
                <MenuItem Header="Resource _Information..." Command="{Binding ResourceInformationCommand}" />
                <MenuItem Header="_Delete Resource" Command="{Binding DeleteResourceCommand}" />
                <Separator />
                <MenuItem Header="_Level Resources..." Command="{Binding LevelResourcesCommand}" />
            </MenuItem>
            <MenuItem Header="_Project">
                <MenuItem Header="Project _Information..." Command="{Binding ProjectInformationCommand}" />
                <MenuItem Header="Change _Working Time..." Command="{Binding ChangeWorkingTimeCommand}" />
                <Separator />
                <MenuItem Header="Set _Baseline..." Command="{Binding SetBaselineCommand}" />
                <MenuItem Header="_Clear Baseline..." Command="{Binding ClearBaselineCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom _In" InputGestureText="Ctrl++" Command="{Binding ZoomInCommand}" />
                <MenuItem Header="Zoom _Out" InputGestureText="Ctrl+-" Command="{Binding ZoomOutCommand}" />
                <MenuItem Header="_Scroll to Task" InputGestureText="Ctrl+Shift+F5" Command="{Binding ScrollToTaskCommand}" />
                <Separator />
                <MenuItem Header="_Critical Path" IsCheckable="True" IsChecked="{Binding ShowCriticalPath}" />
                <MenuItem Header="_Baseline" IsCheckable="True" IsChecked="{Binding ShowBaseline}" />
                <Separator />
                <MenuItem Header="_Sort..." Command="{Binding SortCommand}" />
                <MenuItem Header="Sort by _ID" Command="{Binding SortByIdCommand}" />
                <MenuItem Header="Edit _Tables..." Command="{Binding EditTableCommand}" />
                <MenuItem Header="Edit _Filters..." Command="{Binding EditFilterCommand}" />
                <MenuItem Header="Edit _Groups..." Command="{Binding EditGroupCommand}" />
                <MenuItem Header="Custom Fiel_ds..." Command="{Binding CustomFieldsCommand}" />
                <Separator />
                <MenuItem Header="Sa_ve View..." Command="{Binding SaveViewCommand}" />
                <MenuItem Header="Saved _Views" ItemsSource="{Binding SavedViewNames}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Command" Value="{Binding DataContext.ApplySavedViewCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Ribbon-style toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ChromeBackground}" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="0,0,0,1" Padding="6,4">
            <WrapPanel>
                <Button Style="{StaticResource ToolButton}" Command="{Binding NewCommand}" ToolTip="New project (Ctrl+N)">
                    <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8A5;" /><TextBlock Text="New" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding OpenCommand}" ToolTip="Open project (Ctrl+O)">
                    <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8E5;" /><TextBlock Text="Open" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding SaveCommand}" ToolTip="Save (Ctrl+S)">
                    <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74E;" /><TextBlock Text="Save" /></StackPanel>
                </Button>
                <Rectangle Style="{StaticResource ToolSeparator}" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding UndoCommand}" ToolTip="{Binding Document.UndoDescription, StringFormat='Undo {0} (Ctrl+Z)', TargetNullValue='Undo (Ctrl+Z)'}">
                    <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE7A7;" /><TextBlock Text="Undo" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding RedoCommand}" ToolTip="{Binding Document.RedoDescription, StringFormat='Redo {0} (Ctrl+Y)', TargetNullValue='Redo (Ctrl+Y)'}">
                    <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE7A6;" /><TextBlock Text="Redo" /></StackPanel>
                </Button>
                <Rectangle Style="{StaticResource ToolSeparator}" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding InsertTaskCommand}" ToolTip="Insert task (Ins)">
                    <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE710;" /><TextBlock Text="Task" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding InsertSummaryCommand}" ToolTip="Insert summary task above the selected tasks">
                    <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8FD;" /><TextBlock Text="Summary" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding InsertMilestoneCommand}" ToolTip="Insert milestone">
                    <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE7C1;" /><TextBlock Text="Milestone" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding DeleteTaskCommand}" ToolTip="Delete selected tasks (Del)">
                    <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74D;" /><TextBlock Text="Delete" /></StackPanel>
                </Button>
                <Rectangle Style="{StaticResource ToolSeparator}" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding OutdentCommand}" ToolTip="Outdent (Alt+Shift+Left)">
                    <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE72B;" /><TextBlock Text="Outdent" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding IndentCommand}" ToolTip="Indent (Alt+Shift+Right)">
                    <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE72A;" /><TextBlock Text="Indent" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding LinkCommand}" ToolTip="Link selected tasks finish-to-start (Ctrl+F2)">
                    <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE71B;" /><TextBlock Text="Link" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding UnlinkCommand}" ToolTip="Unlink selected tasks (Ctrl+Shift+F2)">
                    <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8D8;" /><TextBlock Text="Unlink" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleModeCommand}" ToolTip="Switch selected tasks between manual and automatic scheduling">
                    <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE718;" /><TextBlock Text="Mode" /></StackPanel>
                </Button>
                <Rectangle Style="{StaticResource ToolSeparator}" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding ZoomOutCommand}" ToolTip="Zoom out (Ctrl+-, or Ctrl+wheel)">
                    <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE71F;" /><TextBlock Text="Zoom out" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ZoomInCommand}" ToolTip="Zoom in (Ctrl++, or Ctrl+wheel)">
                    <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8A3;" /><TextBlock Text="Zoom in" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ScrollToTaskCommand}" ToolTip="Scroll the chart to the selected task (Ctrl+Shift+F5)">
                    <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8B0;" /><TextBlock Text="Go to task" /></StackPanel>
                </Button>
                <Rectangle Style="{StaticResource ToolSeparator}" />
                <StackPanel VerticalAlignment="Center" Margin="4,0">
                    <CheckBox Content="Critical path" IsChecked="{Binding ShowCriticalPath}" Margin="0,2" />
                    <CheckBox Content="Baseline" IsChecked="{Binding ShowBaseline}" Margin="0,2" />
                </StackPanel>                <Rectangle Style="{StaticResource ToolSeparator}" />
                <Grid VerticalAlignment="Center" Margin="4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Table:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding TableNames}" SelectedItem="{Binding CurrentTableName}" Margin="0,1" />
                    <TextBlock Grid.Column="2" Text="Filter:" VerticalAlignment="Center" Margin="10,0,4,0" />
                    <ComboBox Grid.Column="3" ItemsSource="{Binding FilterNames}" SelectedItem="{Binding CurrentFilterName}" Margin="0,1" />
                    <TextBlock Grid.Row="1" Text="Group:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding GroupNames}" SelectedItem="{Binding CurrentGroupName}" Margin="0,1" />
                    <Button Grid.Row="1" Grid.Column="3" Content="Sort..." Command="{Binding SortCommand}" HorizontalAlignment="Left" Padding="10,1" Margin="0,1" />
                </Grid>
            </WrapPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource ChromeBackground}">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
        </StatusBar>

        <!-- View bar, as in Microsoft Project -->
        <Border DockPanel.Dock="Left" Background="#2B579A" Width="92">
            <ListBox ItemsSource="{Binding Views}" SelectedItem="{Binding CurrentViewOption}"
                     Background="Transparent" BorderThickness="0" Foreground="White"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3C6AAE" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1E3F70" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ViewOption}">
                        <StackPanel>
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <ContentControl x:Name="ViewHost" />
    </DockPanel>
</Window>

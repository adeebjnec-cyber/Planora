<Window x:Class="Planora.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Planora.App.ViewModels"
        xmlns:views="clr-namespace:Planora.App.Views"
        xmlns:infra="clr-namespace:Planora.App.Infrastructure"
        Title="{Binding WindowTitle}"
        Height="760" Width="1280" MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI" FontSize="12">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F12" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}" />
        <KeyBinding Key="Insert" Command="{Binding InsertTaskCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt+Shift" Command="{Binding IndentCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt+Shift" Command="{Binding OutdentCommand}" />
        <KeyBinding Key="Up" Modifiers="Alt+Shift" Command="{Binding MoveTaskUpCommand}" />
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding FindCommand}" />
        <KeyBinding Key="H" Modifiers="Ctrl" Command="{Binding ReplaceCommand}" />
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding FillDownCommand}" />
        <KeyBinding Key="F7" Command="{Binding SpellingCommand}" />
        <KeyBinding Key="Down" Modifiers="Alt+Shift" Command="{Binding MoveTaskDownCommand}" />
        <KeyBinding Key="F2" Modifiers="Control" Command="{Binding LinkCommand}" />
        <KeyBinding Key="F2" Modifiers="Control+Shift" Command="{Binding UnlinkCommand}" />
        <KeyBinding Key="F5" Modifiers="Control+Shift" Command="{Binding ScrollToTaskCommand}" />
        <KeyBinding Key="F2" Modifiers="Shift" Command="{Binding TaskInformationCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Ribbon DockPanel.Dock="Top" x:Name="MainRibbon" Background="{StaticResource ChromeBackground}">
            <Ribbon.QuickAccessToolBar>
                <RibbonQuickAccessToolBar>
                    <RibbonButton SmallImageSource="{infra:Glyph &#xE74E;}" Command="{Binding SaveCommand}" ToolTipTitle="Save (Ctrl+S)" />
                    <RibbonButton SmallImageSource="{infra:Glyph &#xE7A7;}" Command="{Binding UndoCommand}" ToolTipTitle="Undo (Ctrl+Z)" />
                    <RibbonButton SmallImageSource="{infra:Glyph &#xE7A6;}" Command="{Binding RedoCommand}" ToolTipTitle="Redo (Ctrl+Y)" />
                </RibbonQuickAccessToolBar>
            </Ribbon.QuickAccessToolBar>

            <Ribbon.ApplicationMenu>
                <RibbonApplicationMenu SmallImageSource="{infra:Glyph &#xE8A5;}" Label="File">
                    <RibbonApplicationMenuItem Header="New" ImageSource="{infra:Glyph &#xE8A5;}" Command="{Binding NewCommand}" />
                    <RibbonApplicationMenuItem Header="New from Template..." ImageSource="{infra:Glyph &#xE8F4;}" Command="{Binding NewFromTemplateCommand}" />
                    <RibbonApplicationMenuItem Header="Open..." ImageSource="{infra:Glyph &#xE8E5;}" Command="{Binding OpenCommand}" />
                    <RibbonApplicationMenuItem Header="Open Sample Project" ImageSource="{infra:Glyph &#xE8B7;}" Command="{Binding OpenSampleCommand}" />
                    <RibbonApplicationMenuItem Header="Save" ImageSource="{infra:Glyph &#xE74E;}" Command="{Binding SaveCommand}" />
                    <RibbonApplicationMenuItem Header="Save As..." ImageSource="{infra:Glyph &#xE792;}" Command="{Binding SaveAsCommand}" />
                    <RibbonApplicationMenuItem Header="Save as Template..." ImageSource="{infra:Glyph &#xE8F4;}" Command="{Binding SaveAsTemplateCommand}" />
                    <RibbonSeparator />
                    <RibbonApplicationMenuItem Header="Import..." ImageSource="{infra:Glyph &#xE8B5;}" Command="{Binding ImportCommand}" />
                    <RibbonApplicationMenuItem Header="Export..." ImageSource="{infra:Glyph &#xEDE1;}" Command="{Binding ExportCommand}" />
                    <RibbonApplicationMenuItem Header="Export as PDF..." ImageSource="{infra:Glyph &#xEA90;}" Command="{Binding ExportPdfCommand}" />
                    <RibbonApplicationMenuItem Header="Export as Image..." ImageSource="{infra:Glyph &#xEB9F;}" Command="{Binding ExportImageCommand}" />
                    <RibbonApplicationMenuItem Header="Print..." ImageSource="{infra:Glyph &#xE749;}" Command="{Binding PrintCommand}" />
                    <RibbonSeparator />
                    <RibbonApplicationMenuItem Header="Options..." ImageSource="{infra:Glyph &#xE713;}" Command="{Binding OptionsCommand}" />
                    <RibbonApplicationMenu.FooterPaneContent>
                        <RibbonButton Label="Exit" HorizontalAlignment="Right" Click="OnExit" />
                    </RibbonApplicationMenu.FooterPaneContent>
                </RibbonApplicationMenu>
            </Ribbon.ApplicationMenu>

            <RibbonTab Header="Task">
                <RibbonGroup Header="Clipboard">
                    <RibbonButton Label="Paste" LargeImageSource="{infra:Glyph &#xE77F;}" Command="{Binding PasteCommand}" ToolTipTitle="Paste tasks (Ctrl+V)" />
                    <RibbonButton Label="Cut" SmallImageSource="{infra:Glyph &#xE8C6;}" Command="{Binding CutCommand}" ToolTipTitle="Cut tasks (Ctrl+X)" />
                    <RibbonButton Label="Copy" SmallImageSource="{infra:Glyph &#xE8C8;}" Command="{Binding CopyCommand}" ToolTipTitle="Copy tasks (Ctrl+C)" />
                </RibbonGroup>
                <RibbonGroup Header="Schedule">
                    <RibbonButton Label="Outdent" SmallImageSource="{infra:Glyph &#xE72B;}" Command="{Binding OutdentCommand}" ToolTipTitle="Outdent (Alt+Shift+Left)" />
                    <RibbonButton Label="Indent" SmallImageSource="{infra:Glyph &#xE72A;}" Command="{Binding IndentCommand}" ToolTipTitle="Indent (Alt+Shift+Right)" />
                    <RibbonButton Label="Move Up" SmallImageSource="{infra:Glyph &#xE74A;}" Command="{Binding MoveTaskUpCommand}" ToolTipTitle="Move task up (Alt+Shift+Up)" />
                    <RibbonButton Label="Move Down" SmallImageSource="{infra:Glyph &#xE74B;}" Command="{Binding MoveTaskDownCommand}" ToolTipTitle="Move task down (Alt+Shift+Down)" />
                    <RibbonButton Label="Link" SmallImageSource="{infra:Glyph &#xE71B;}" Command="{Binding LinkCommand}" ToolTipTitle="Link selected tasks (Ctrl+F2)" />
                    <RibbonButton Label="Unlink" SmallImageSource="{infra:Glyph &#xE8D8;}" Command="{Binding UnlinkCommand}" ToolTipTitle="Unlink tasks (Ctrl+Shift+F2)" />
                    <RibbonButton Label="Split Task" SmallImageSource="{infra:Glyph &#xE8C6;}" Command="{Binding SplitTaskCommand}" />
                    <RibbonToggleButton Label="Split Mode" SmallImageSource="{infra:Glyph &#xE7AD;}" IsChecked="{Binding IsSplitMode}" ToolTipTitle="Click a bar to split it there" />
                </RibbonGroup>
                <RibbonGroup Header="Progress">
                    <RibbonButton Label="0%" SmallImageSource="{infra:Glyph &#xF16B;}" Command="{Binding PercentCompleteCommand}" CommandParameter="0" ToolTipTitle="0% complete" />
                    <RibbonButton Label="25%" SmallImageSource="{infra:Glyph &#xF16C;}" Command="{Binding PercentCompleteCommand}" CommandParameter="25" ToolTipTitle="25% complete" />
                    <RibbonButton Label="50%" SmallImageSource="{infra:Glyph &#xF16D;}" Command="{Binding PercentCompleteCommand}" CommandParameter="50" ToolTipTitle="50% complete" />
                    <RibbonButton Label="75%" SmallImageSource="{infra:Glyph &#xF16E;}" Command="{Binding PercentCompleteCommand}" CommandParameter="75" ToolTipTitle="75% complete" />
                    <RibbonButton Label="100%" SmallImageSource="{infra:Glyph &#xF16F;}" Command="{Binding PercentCompleteCommand}" CommandParameter="100" ToolTipTitle="100% complete" />
                    <RibbonButton Label="Mark on Track" SmallImageSource="{infra:Glyph &#xE73E;}" Command="{Binding MarkOnTrackCommand}" ToolTipTitle="Progress as scheduled up to the status date" />
                    <RibbonButton Label="Update Tasks" SmallImageSource="{infra:Glyph &#xE70F;}" Command="{Binding UpdateTasksCommand}" ToolTipTitle="Enter % complete, actual and remaining duration, actual dates" />
                </RibbonGroup>
                <RibbonGroup Header="Tasks">
                    <RibbonButton Label="Manual / Auto" LargeImageSource="{infra:Glyph &#xE718;}" Command="{Binding ToggleModeCommand}" ToolTipTitle="Switch selected tasks between manual and automatic scheduling" />
                    <RibbonButton Label="Go to Task" SmallImageSource="{infra:Glyph &#xE8B0;}" Command="{Binding ScrollToTaskCommand}" ToolTipTitle="Scroll the chart to the selected task (Ctrl+Shift+F5)" />
                    <RibbonButton Label="Add to Timeline" SmallImageSource="{infra:Glyph &#xE823;}" Command="{Binding AddToTimelineCommand}" />
                </RibbonGroup>
                <RibbonGroup Header="Insert">
                    <RibbonButton Label="Task" LargeImageSource="{infra:Glyph &#xE710;}" Command="{Binding InsertTaskCommand}" ToolTipTitle="Insert task (Ins)" />
                    <RibbonButton Label="Summary" SmallImageSource="{infra:Glyph &#xE8FD;}" Command="{Binding InsertSummaryCommand}" />
                    <RibbonButton Label="Milestone" SmallImageSource="{infra:Glyph &#xE7C1;}" Command="{Binding InsertMilestoneCommand}" />
                    <RibbonButton Label="Recurring Task" SmallImageSource="{infra:Glyph &#xE8EE;}" Command="{Binding RecurringTaskCommand}" />
                </RibbonGroup>
                <RibbonGroup Header="Editing">
                    <RibbonButton Label="Find" SmallImageSource="{infra:Glyph &#xE721;}" Command="{Binding FindCommand}" ToolTipTitle="Find (Ctrl+F)" />
                    <RibbonButton Label="Replace" SmallImageSource="{infra:Glyph &#xE8AB;}" Command="{Binding ReplaceCommand}" ToolTipTitle="Replace (Ctrl+H)" />
                    <RibbonButton Label="Fill Down" SmallImageSource="{infra:Glyph &#xE74B;}" Command="{Binding FillDownCommand}" ToolTipTitle="Copy the top cell down the selected rows (Ctrl+D)" />
                    <RibbonButton Label="Spelling" SmallImageSource="{infra:Glyph &#xF87B;}" Command="{Binding SpellingCommand}" ToolTipTitle="Check spelling (F7)" />
                </RibbonGroup>
                <RibbonGroup Header="Properties">
                    <RibbonButton Label="Information" LargeImageSource="{infra:Glyph &#xE946;}" Command="{Binding TaskInformationCommand}" ToolTipTitle="Task Information (Shift+F2)" />
                    <RibbonButton Label="Delete" SmallImageSource="{infra:Glyph &#xE74D;}" Command="{Binding DeleteTaskCommand}" ToolTipTitle="Delete selected tasks (Del)" />
                    <RibbonButton Label="Open Hyperlink" SmallImageSource="{infra:Glyph &#xE71B;}" Command="{Binding OpenHyperlinkCommand}" ToolTipTitle="Open the selected task's hyperlink (set it in Task Information > Advanced)" />
                </RibbonGroup>
            </RibbonTab>

            <RibbonTab Header="Resource">
                <RibbonGroup Header="View">
                    <RibbonButton Label="Resource Sheet" LargeImageSource="{infra:Glyph &#xE716;}" Click="OnShowResourceSheet" />
                    <RibbonButton Label="Resource Usage" LargeImageSource="{infra:Glyph &#xE9F9;}" Click="OnShowResourceUsage" />
                </RibbonGroup>
                <RibbonGroup Header="Properties">
                    <RibbonButton Label="Information" LargeImageSource="{infra:Glyph &#xE946;}" Command="{Binding ResourceInformationCommand}" ToolTipTitle="Resource Information (select a resource in the Resource Sheet)" />
                    <RibbonButton Label="Delete Resource" SmallImageSource="{infra:Glyph &#xE74D;}" Command="{Binding DeleteResourceCommand}" />
                    <RibbonButton Label="Budgets" SmallImageSource="{infra:Glyph &#xE8C7;}" Command="{Binding BudgetsCommand}" />
                </RibbonGroup>
                <RibbonGroup Header="Resource Pool">
                    <RibbonButton Label="Share Resources" LargeImageSource="{infra:Glyph &#xE716;}" Command="{Binding ShareResourcesCommand}" ToolTipTitle="Use the resources of a resource pool file" />
                    <RibbonButton Label="Refresh from Pool" SmallImageSource="{infra:Glyph &#xE72C;}" Command="{Binding RefreshPoolCommand}" />
                    <RibbonButton Label="Update Pool" SmallImageSource="{infra:Glyph &#xE74E;}" Command="{Binding UpdatePoolCommand}" />
                </RibbonGroup>                <RibbonGroup Header="Level">
                    <RibbonButton Label="Leveling Options" LargeImageSource="{infra:Glyph &#xE9F5;}" Command="{Binding LevelResourcesCommand}" ToolTipTitle="Level resources, or clear leveling" />
                </RibbonGroup>
            </RibbonTab>

            <RibbonTab Header="Report">
                <RibbonGroup Header="Dashboards">
                    <RibbonButton Label="Project Overview" LargeImageSource="{infra:Glyph &#xE9D2;}" Command="{Binding ReportsCommand}" CommandParameter="Project Overview" />
                    <RibbonButton Label="Cost Overview" LargeImageSource="{infra:Glyph &#xE8C7;}" Command="{Binding ReportsCommand}" CommandParameter="Cost Overview" />
                    <RibbonButton Label="Earned Value" LargeImageSource="{infra:Glyph &#xE9D9;}" Command="{Binding ReportsCommand}" CommandParameter="Earned Value" />
                </RibbonGroup>
                <RibbonGroup Header="Tasks">
                    <RibbonButton Label="Critical Tasks" SmallImageSource="{infra:Glyph &#xE7BA;}" Command="{Binding ReportsCommand}" CommandParameter="Critical Tasks" />
                    <RibbonButton Label="Task Status" SmallImageSource="{infra:Glyph &#xE73E;}" Command="{Binding ReportsCommand}" CommandParameter="Task Status" />
                    <RibbonButton Label="Milestones" SmallImageSource="{infra:Glyph &#xE7C1;}" Command="{Binding ReportsCommand}" CommandParameter="Milestones" />
                </RibbonGroup>
                <RibbonGroup Header="Resources">
                    <RibbonButton Label="Resource Overview" SmallImageSource="{infra:Glyph &#xE716;}" Command="{Binding ReportsCommand}" CommandParameter="Resource Overview" />
                    <RibbonButton Label="Who Does What" SmallImageSource="{infra:Glyph &#xE77B;}" Command="{Binding ReportsCommand}" CommandParameter="Who Does What" />
                </RibbonGroup>
                <RibbonGroup Header="Export">
                    <RibbonButton Label="PDF" LargeImageSource="{infra:Glyph &#xEA90;}" Command="{Binding ExportPdfCommand}" />
                    <RibbonButton Label="Print" LargeImageSource="{infra:Glyph &#xE749;}" Command="{Binding PrintCommand}" ToolTipTitle="Print (Ctrl+P)" />
                </RibbonGroup>
            </RibbonTab>

            <RibbonTab Header="Project">
                <RibbonGroup Header="Properties">
                    <RibbonButton Label="Project Information" LargeImageSource="{infra:Glyph &#xE946;}" Command="{Binding ProjectInformationCommand}" />
                    <RibbonButton Label="Custom Fields" SmallImageSource="{infra:Glyph &#xE8EC;}" Command="{Binding CustomFieldsCommand}" />
                    <RibbonButton Label="Change Working Time" SmallImageSource="{infra:Glyph &#xE787;}" Command="{Binding ChangeWorkingTimeCommand}" />
                </RibbonGroup>
                <RibbonGroup Header="Schedule">
                    <RibbonButton Label="Set Baseline" LargeImageSource="{infra:Glyph &#xE9D9;}" Command="{Binding SetBaselineCommand}" />
                    <RibbonButton Label="Clear Baseline" SmallImageSource="{infra:Glyph &#xE894;}" Command="{Binding ClearBaselineCommand}" />
                </RibbonGroup>
                <RibbonGroup Header="Status">
                    <RibbonButton Label="Update Project" LargeImageSource="{infra:Glyph &#xE895;}" Command="{Binding UpdateProjectCommand}" ToolTipTitle="Mark work complete through a date, or reschedule unfinished work" />
                </RibbonGroup>
                <RibbonGroup Header="Subprojects">
                    <RibbonButton Label="Insert Project" LargeImageSource="{infra:Glyph &#xE8F4;}" Command="{Binding InsertProjectCommand}" ToolTipTitle="Insert another project file as a subproject" />
                    <RibbonButton Label="Refresh" SmallImageSource="{infra:Glyph &#xE72C;}" Command="{Binding RefreshSubprojectCommand}" ToolTipTitle="Reload the selected subproject from its file" />
                    <RibbonButton Label="Save Subproject" SmallImageSource="{infra:Glyph &#xE74E;}" Command="{Binding SaveSubprojectCommand}" ToolTipTitle="Save the selected subproject back to its file" />
                </RibbonGroup>                <RibbonGroup Header="Data Exchange">
                    <RibbonButton Label="Import" SmallImageSource="{infra:Glyph &#xE8B5;}" Command="{Binding ImportCommand}" />
                    <RibbonButton Label="Export" SmallImageSource="{infra:Glyph &#xEDE1;}" Command="{Binding ExportCommand}" />
                </RibbonGroup>
            </RibbonTab>

            <RibbonTab Header="Format">
                <RibbonGroup Header="Format">
                    <RibbonButton Label="Text Styles" LargeImageSource="{infra:Glyph &#xE8D2;}" Command="{Binding TextStylesCommand}" ToolTipTitle="Fonts for bar text and for summary, critical, milestone and marked rows" />
                    <RibbonButton Label="Gridlines" SmallImageSource="{infra:Glyph &#xE80A;}" Command="{Binding GridlinesCommand}" ToolTipTitle="Row and column lines, date lines" />
                    <RibbonButton Label="Timescale" SmallImageSource="{infra:Glyph &#xE823;}" Command="{Binding TimescaleCommand}" ToolTipTitle="One to three timescale tiers with their units and labels" />
                </RibbonGroup>
                <RibbonGroup Header="Bar Styles">
                    <RibbonButton Label="Bar Styles" LargeImageSource="{infra:Glyph &#xE790;}" Command="{Binding BarStylesCommand}" ToolTipTitle="Colours, shapes and texts of the Gantt bars" />
                    <StackPanel Margin="4,2">
                        <CheckBox Content="Critical Tasks" IsChecked="{Binding ShowCriticalPath}" Margin="0,2" />
                        <CheckBox Content="Baseline" IsChecked="{Binding ShowBaseline}" Margin="0,2" />
                        <CheckBox Content="Progress Lines" IsChecked="{Binding ShowProgressLines}" Margin="0,2" />
                    </StackPanel>
                </RibbonGroup>
                <RibbonGroup Header="Columns">
                    <RibbonButton Label="Edit Table" LargeImageSource="{infra:Glyph &#xE8A1;}" Command="{Binding EditTableCommand}" ToolTipTitle="Insert, remove and arrange columns" />
                    <RibbonButton Label="Custom Fields" SmallImageSource="{infra:Glyph &#xE8EC;}" Command="{Binding CustomFieldsCommand}" />
                </RibbonGroup>
            </RibbonTab>

            <RibbonTab Header="View">
                <RibbonGroup Header="Data">
                    <StackPanel Margin="4,2">
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="Table:" Width="44" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding TableNames}" SelectedItem="{Binding CurrentTableName}" Width="150" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="Filter:" Width="44" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding FilterNames}" SelectedItem="{Binding CurrentFilterName}" Width="150" />
                            <CheckBox Content="Highlight" IsChecked="{Binding HighlightFilter}" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="Highlight matching tasks instead of hiding the others" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="Group:" Width="44" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding GroupNames}" SelectedItem="{Binding CurrentGroupName}" Width="150" />
                        </StackPanel>
                    </StackPanel>
                    <RibbonButton Label="Sort" LargeImageSource="{infra:Glyph &#xE8CB;}" Command="{Binding SortCommand}" />
                    <RibbonMenuButton Label="Define" LargeImageSource="{infra:Glyph &#xE70F;}">
                        <RibbonMenuItem Header="Tables..." Command="{Binding EditTableCommand}" />
                        <RibbonMenuItem Header="Filters..." Command="{Binding EditFilterCommand}" />
                        <RibbonMenuItem Header="Groups..." Command="{Binding EditGroupCommand}" />
                        <RibbonMenuItem Header="Custom Fields..." Command="{Binding CustomFieldsCommand}" />
                        <RibbonMenuItem Header="Sort by ID" Command="{Binding SortByIdCommand}" />
                    </RibbonMenuButton>
                </RibbonGroup>
                <RibbonGroup Header="Zoom">
                    <RibbonButton Label="Zoom In" SmallImageSource="{infra:Glyph &#xE8A3;}" Command="{Binding ZoomInCommand}" ToolTipTitle="Zoom in (Ctrl++, or Ctrl+wheel)" />
                    <RibbonButton Label="Zoom Out" SmallImageSource="{infra:Glyph &#xE71F;}" Command="{Binding ZoomOutCommand}" ToolTipTitle="Zoom out (Ctrl+-, or Ctrl+wheel)" />
                </RibbonGroup>
                <RibbonGroup Header="Show">
                    <StackPanel Margin="4,2">
                        <CheckBox Content="Critical Path" IsChecked="{Binding ShowCriticalPath}" Margin="0,2" />
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <CheckBox Content="Baseline" IsChecked="{Binding ShowBaseline}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{x:Static vm:MainViewModel.BaselineNames}" SelectedIndex="{Binding GanttBaselineIndex}" Width="90"
                                      IsEnabled="{Binding ShowBaseline}" ToolTip="Which baseline to draw under the bars" />
                        </StackPanel>
                        <CheckBox Content="Progress Lines" IsChecked="{Binding ShowProgressLines}" Margin="0,2" />
                    </StackPanel>
                </RibbonGroup>
                <RibbonGroup Header="Usage Details">
                    <StackPanel Margin="4,2">
                        <CheckBox Content="Actual Work" IsChecked="{Binding ShowActualWorkDetail}" Margin="0,1" />
                        <CheckBox Content="Remaining Work" IsChecked="{Binding ShowRemainingWorkDetail}" Margin="0,1" />
                        <CheckBox Content="Baseline Work" IsChecked="{Binding ShowBaselineWorkDetail}" Margin="0,1" />
                    </StackPanel>
                    <StackPanel Margin="4,2">
                        <CheckBox Content="Cost" IsChecked="{Binding ShowCostDetail}" Margin="0,1" />
                        <CheckBox Content="Actual Cost" IsChecked="{Binding ShowActualCostDetail}" Margin="0,1" />
                        <CheckBox Content="Baseline Cost" IsChecked="{Binding ShowBaselineCostDetail}" Margin="0,1" />
                    </StackPanel>
                </RibbonGroup>
                <RibbonGroup Header="Split View">
                    <StackPanel Margin="4,2">
                        <CheckBox Content="Details (Task Form)" IsChecked="{Binding ShowTaskForm}" Margin="0,2" ToolTip="Show the selected task's details under the view" />
                    </StackPanel>
                </RibbonGroup>
                <RibbonGroup Header="Views">
                    <RibbonButton Label="Save View" LargeImageSource="{infra:Glyph &#xE78C;}" Command="{Binding SaveViewCommand}" />
                    <RibbonMenuButton Label="Saved Views" LargeImageSource="{infra:Glyph &#xE8A9;}" ItemsSource="{Binding SavedViewNames}">
                        <RibbonMenuButton.ItemContainerStyle>
                            <Style TargetType="RibbonMenuItem">
                                <Setter Property="Command" Value="{Binding DataContext.ApplySavedViewCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Setter Property="CommandParameter" Value="{Binding}" />
                                <Setter Property="Header" Value="{Binding}" />
                            </Style>
                        </RibbonMenuButton.ItemContainerStyle>
                    </RibbonMenuButton>
                </RibbonGroup>
            </RibbonTab>
        </Ribbon>

        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource ChromeBackground}">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
        </StatusBar>

        <!-- View bar, as in Microsoft Project -->
        <Border DockPanel.Dock="Left" Background="#2B579A" Width="92">
            <ListBox ItemsSource="{Binding Views}" SelectedItem="{Binding CurrentViewOption}"
                     Background="Transparent" BorderThickness="0" Foreground="White"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3C6AAE" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1E3F70" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ViewOption}">
                        <StackPanel>
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl x:Name="ViewHost" />
            <views:TaskFormPanel Grid.Row="1" Height="230" Visibility="{Binding ShowTaskForm, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</Window>